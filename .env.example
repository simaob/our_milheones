# Copy to .env and fill in before deploying. .env is not committed.
# config/deploy.yml loads it, and .kamal/secrets reads the secrets from it.

# The server to deploy to (Kamal installs Docker on it during `bin/kamal setup`).
OUR_MILHEONES_SERVER_IP=

# Password for the `our_milheones` role of the Postgres accessory (pick a long random one,
# e.g. `openssl rand -hex 32`). It is set when the database is first created.
POSTGRES_PASSWORD=

# SMTP password for outgoing mail; with the default SendGrid relay this is the API key.
SMTP_PASSWORD=
