<h1>Listing Bets</h1>

<%= paginate @bets, theme: 'twitter-bootstrap-3',
  pagination_class:  "pagination-sm" %>

<table class="table table-bordered table-condensed">
  <thead>
    <tr>
      <th>Bet</th>
      <th>User</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @bets.each do |bet| %>
      <tr>
        <td><%= formatted_bet bet, bet.week.try(:solution) %></td>
        <td><%= bet.user.try(:name) %></td>
        <td>
          <%= link_to 'Show', bet %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @bets, theme: 'twitter-bootstrap-3',
  pagination_class:  "pagination-sm" %>
