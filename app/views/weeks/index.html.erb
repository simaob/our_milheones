<h1>Week by week</h1>
<%= paginate @weeks, theme: 'twitter-bootstrap-3',
  pagination_class:  "pagination-sm" %>
<% @weeks_month.each do |month, weeks| %>
  <h4><%= month %></h4>
  <% if weeks.any?(&:member_bets?) %>
    <%= render "member_bets_table", weeks: weeks %>
  <% else %>
    <%= render "table", weeks: weeks %>
  <% end %>
<% end %>
<%= paginate @weeks, theme: 'twitter-bootstrap-3',
  pagination_class:  "pagination-sm" %>
