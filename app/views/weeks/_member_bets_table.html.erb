<%# Weeks from when each member picked their own numbers (see Week::MEMBER_BETS_UNTIL). %>
<table class="table table-bordered table-condensed">
  <thead>
    <tr>
      <th>Number</th>
      <th>Friday</th>
      <th>Solution</th>
      <th>Prize</th>
      <th>Bets</th>
      <th>Your bet</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% weeks.each do |week| %>
      <tr class="<%= if week == current_week then "success" end %>">
        <td><%= week.number %></td>
        <td><%= week.friday.to_fs %></td>
        <td><%= print_bet week.solution %></td>
        <td><span class="<%= "label label-success" if week.prize && week.prize > 0.0 %>">
          €<%= week.prize.presence || 0.0 %></span></td>
        <td><%= week.bets.size %>
          (<%= week.bets_missing %> missing)
        </td>
        <td>
          <% if week.member_bets? %>
            <%= formatted_bet(week.bet_from(current_user), week.solution) %>
          <% end %>
        </td>
        <td><%= render "actions", week: week %></td>
      </tr>
    <% end %>
  </tbody>
</table>
