# Secrets for Kamal, read from the "our_milheones" item in the Personal vault of the
# my.1password.com 1Password account (fields RAILS_MASTER_KEY, POSTGRES_PASSWORD, SENDGRID_API_KEY).
#
# Needs the 1Password CLI (`brew install --cask 1password-cli`) with the app integration on:
# 1Password > Settings > Developer > "Integrate with 1Password CLI". Kamal stops with an error
# if the item or one of the fields is missing. See README.md for creating the item.
#
# Never put secret values in this file: it is committed.
SECRETS=$(kamal secrets fetch --adapter 1password --account my.1password.com --from Personal/our_milheones RAILS_MASTER_KEY POSTGRES_PASSWORD SENDGRID_API_KEY)

RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)
# The app reads the SMTP password from SMTP_PASSWORD (see config/environments/production.rb);
# with SendGrid it is the API key.
SMTP_PASSWORD=$(kamal secrets extract SENDGRID_API_KEY $SECRETS)
